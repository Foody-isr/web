NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080
NEXT_PUBLIC_API_TOKEN= # optional dev JWT token (Bearer) from foodyserver login for staff APIs
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3003

# Currency Configuration (ILS for Israel, USD, EUR, etc.)
# NEXT_PUBLIC_CURRENCY=ILS

# Dev-only: show "Skip OTP" button on checkout (never enable in production)
# NEXT_PUBLIC_SKIP_OTP_ENABLED=true

# Google OAuth client id for guest "Sign in with Google" (reorder). Public,
# not a secret. Optional — falls back to the platform default in lib/constants.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=701419085438-...apps.googleusercontent.com

# Marketing site the "Powered by Foody" attribution links to. Optional —
# defaults to https://www.foody-pos.co.il in components/PoweredByFoody.tsx.
# NEXT_PUBLIC_FOODY_SITE_URL=https://www.foody-pos.co.il

# Server-only secret shared by API and guest Web for authenticated test-access IP assertions.
# Generate a random value of at least 32 characters; use a separate value per environment.
# Never prefix with NEXT_PUBLIC_. Web signs only Vercel platform-owned IP headers.
ORDERING_TEST_PROXY_SECRET=

# Dev API key on staged production artifacts, selected from the backend origin.
ORDERING_TEST_PROXY_SECRET_DEV=

# Controlled loyalty customer page and BFF routes. Requires compatible opt-in API.
# Does not activate a program, payment/reward selection or Apple/Google Wallet.
NEXT_PUBLIC_LOYALTY_WEB_ENABLED=false

# Separate reward selection/order creation rollout; requires the loyalty Web/API flags.
NEXT_PUBLIC_LOYALTY_CHECKOUT_ENABLED=false

# Wallet controls and their same-origin gateway: independent build opt-in.
# Requires NEXT_PUBLIC_LOYALTY_WEB_ENABLED and the compatible opted-in API.
# Never expose Wallet signing keys or service account files to the browser.
NEXT_PUBLIC_LOYALTY_WALLET_ENABLED=false
