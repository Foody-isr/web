{
  "name": "foodyweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "node --test --import tsx $(find lib -type f -path '*/__tests__/*.test.ts')",
    "test:website-v3-contract": "node --test --import tsx lib/preview/__tests__/website-v3-capabilities.test.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "sandbox": "ladle serve --port 61000",
    "sandbox:build": "ladle build"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.5",
    "@tanstack/react-query": "^5.29.7",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.4",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "next": "15.5.26",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.59.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.12.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "@swc/helpers": "^0.5.17",
    "postcss": "$postcss"
  }
}
